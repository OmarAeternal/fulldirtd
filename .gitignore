# ─── Python (bisa dibangun ulang; .venv memuat file 766 MB) ───
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ─── ROS 2 hasil colcon (bisa dibangun ulang; memuat file 128 MB) ───
build/
install/
log/
devel/
.catkin_tools/

# ─── Tidak diikutkan atas permintaan ───
backup/

# ─── Basis data SLAM (bisa dibangun ulang) ───
*.db
rtabmap.db

# ─── cloudcom: hanya scan 0080 ke atas ───
cloudcom/*.mcap
cloudcom/*.ply
cloudcom/*.xyz
!cloudcom/scan_008*
!cloudcom/scan_009*
!cloudcom/scan_01*


# ─── cloudcom/out: scan 0080+ dan hasil _pasak / _merged ───
cloudcom/out/*
!cloudcom/out/scan_008*
!cloudcom/out/scan_009*
!cloudcom/out/scan_01*
!cloudcom/out/_pasak/
!cloudcom/out/_merged/

# ─── ros2_ws/cloudcom: scan lama (0001-0005) tidak ikut ───
ros2_ws/cloudcom/scan_000*

# ─── Editor / OS ───
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
node_modules/
*.log
*.tmp

# ─── Pengaturan lokal Claude Code ───
.claude/settings.local.json
